{
    "name": "Devora – Developer tools in your browser",
    "short_name": "Devora",
    "description": "Fast, focused developer utilities that run in your browser and work offline.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#07070b",
    "theme_color": "#6a5cff",
    "categories": [
        "developer",
        "utilities",
        "productivity"
    ],
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml"
        }
    ]
}